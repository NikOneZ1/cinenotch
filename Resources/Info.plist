	<string>CineNotch reveals the video when you glance at the camera. Frames are analyzed on your Mac and are never stored or sent anywhere.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSScreenCaptureUsageDescription</key>
	<string>CineNotch shows the Picture in Picture video inside the island. Only the PiP window is captured and nothing leaves your Mac.</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://cinenotch.cam/appcast.xml</string>
